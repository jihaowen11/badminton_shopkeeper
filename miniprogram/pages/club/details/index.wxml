<loading-bar />
<!--pages/club/details/index.wxml-->
<!-- 分享卡片指向的俱乐部被解散时，给出明确空态 -->
<view wx:if="{{loadFailed}}" class="load-failed">
  <van-icon name="warning-o" size="64rpx" color="rgba(217,134,10,0.6)" />
  <view class="load-failed-title">俱乐部不存在或已解散</view>
  <view class="load-failed-desc">这个分享可能已经过期，去看看别的俱乐部吧</view>
  <view class="load-failed-btn" bindtap="onBackHome" hover-class="load-failed-btn-hover">回到首页</view>
</view>
<view class="page">
  <back  scrollTop="{{membersScrollTop}}"/>

  <view class="hero-bg" aria-hidden="true">
    <view class="hero-ring"></view>
    <view class="hero-ring hero-ring-2"></view>
  </view>

  <view class="main-card">
    <view class="club-head-row">
      <view class="club-avatar-wrap">
        <view class="club-avatar">
          <image wx:if="{{club.avatarUrl}}" class="club-avatar-img" src="{{club.avatarUrl}}" mode="aspectFill" />
          <text wx:else>{{club.abbr}}</text>
        </view>
        <view wx:if="{{club.isPresident}}" class="club-crown">
          <van-icon class="icon" name="gem" size="12" color="#ffffff" />
        </view>
      </view>
      <view class="club-head-text">
        <view class="club-title">{{club.name}}</view>
        <view class="club-line">
          <van-icon class="icon" name="location-o" size="14" color="rgba(18,22,26,0.45)" />
          <text class="club-line-text">{{club.location}}</text>
        </view>
        <view class="club-line">
          <van-icon class="icon" name="clock-o" size="14" color="rgba(18,22,26,0.45)" />
          <text class="club-line-text">{{club.schedule}}</text>
        </view>
      </view>
    </view>
    <view class="club-desc">{{club.desc}}</view>
    <view class="stat-mini-row">
      <view class="stat-mini stat-mini-neutral">
        <view class="stat-mini-num">{{club.memberTotal}}</view>
        <view class="stat-mini-label">成员</view>
      </view>
      <view class="stat-mini stat-mini-male">
        <view class="stat-mini-num">{{club.male}}</view>
        <view class="stat-mini-label">男生</view>
      </view>
      <view class="stat-mini stat-mini-female">
        <view class="stat-mini-num">{{club.female}}</view>
        <view class="stat-mini-label">女生</view>
      </view>
    </view>
  </view>

  <view class="tabs-wrap">
    <view class="tabs-bar">
      <view
        class="tab-item {{activeTab === 'members' ? 'is-active' : ''}}"
        bindtap="onTabMembers"
      >
        成员 ({{memberCount}})
      </view>
      <view
        class="tab-item {{activeTab === 'feed' ? 'is-active' : ''}}"
        bindtap="onTabFeed"
      >
        动态{{feedCount > 0 ? ' (' + feedCount + ')' : ''}}
      </view>
    </view>
  </view>

  <view wx:if="{{activeTab === 'members'}}" class="list-scroll">
    <view
      wx:for="{{members}}"
      wx:key="id"
      class="member-card"
    >
      <view class="member-avatar avatar-{{item.roleType === 'owner' ? 'green' : (item.roleType === 'admin' ? 'blue' : 'pink')}}">
        <image wx:if="{{item.avatarUrl}}" class="member-avatar-img" src="{{item.avatarUrl}}" mode="aspectFill" />
        <text wx:else>{{item.abbr}}</text>
      </view>
      <view class="member-main">
        <view class="member-name-row">
          <text class="member-name">{{item.name}}</text>
          <view wx:if="{{item.roleType === 'owner'}}" class="role-pill role-president">会长</view>
          <view wx:elif="{{item.roleType === 'admin'}}" class="role-pill role-admin">管理员</view>
          <view wx:else class="role-pill role-member">成员</view>
        </view>
        <view class="member-sub">
          <image class="sex" wx:if="{{item.gender === 'male'}}" src="/images/icon/nan.png" mode="widthFix" />
          <image class="sex" wx:elif="{{item.gender === 'female'}}" src="/images/icon/nv.png" mode="widthFix" />
          <text wx:if="{{item.gender !== 'unknown'}}" class="member-dot">·</text>
          <text class="member-level">{{item.level}}</text>
        </view>
      </view>
      <view wx:if="{{!isShareMode}}" class="member-more" data-id="{{item.id}}" bindtap="onMemberMore" hover-class="member-more-hover">
        <van-icon class="icon" name="ellipsis" size="18" color="rgba(18,22,26,0.45)" />
      </view>
    </view>
  </view>

  <!-- 动态：自动生成的时间轴，无需成员发帖 -->
  <view wx:if="{{activeTab === 'feed'}}" class="feed-wrap">
    <view wx:if="{{feedNeedJoin}}" class="feed-placeholder">
      <van-icon name="lock" size="48" color="rgba(10,143,62,0.35)" />
      <view class="feed-title">加入后可查看动态</view>
      <view class="feed-desc">成员才能看到这里的比赛记录和成员动态</view>
    </view>

    <view wx:elif="{{!feedLoaded}}" class="feed-placeholder">
      <view class="feed-title">动态加载中...</view>
    </view>

    <view wx:elif="{{feedList.length === 0}}" class="feed-placeholder">
      <block wx:if="{{feedError}}">
        <van-icon name="warning-o" size="48" color="rgba(217,134,10,0.5)" />
        <view class="feed-title">{{feedError}}</view>
        <view class="feed-empty-btn" bindtap="onFeedRetry">重新加载</view>
      </block>
      <block wx:else>
        <van-icon name="chat-o" size="48" color="rgba(10,143,62,0.35)" />
        <view class="feed-title">还没有动态</view>
        <view class="feed-desc">发起第一场比赛后，赛事战报、成员加入都会自动记录在这里</view>
        <view wx:if="{{canInvite || hasJoined}}" class="feed-empty-btn" bindtap="onFeedCreateMatch">发起第一场球局</view>
      </block>
    </view>

    <view wx:else class="feed-list">
      <view
        wx:for="{{feedList}}"
        wx:key="id"
        class="feed-item"
        data-match-id="{{item.matchId}}"
        data-member-open-id="{{item.memberOpenId}}"
        bindtap="onTapFeed"
        hover-class="feed-item-hover"
      >
        <view class="feed-rail">
          <view class="feed-dot feed-dot--{{item.tone}}">
            <van-icon name="{{item.icon}}" size="16" color="#ffffff" />
          </view>
          <view wx:if="{{index < feedList.length - 1}}" class="feed-line"></view>
        </view>
        <view class="feed-card">
          <view class="feed-card-head">
            <text class="feed-title-text">{{item.title}}</text>
            <text class="feed-time">{{item.timeText}}</text>
          </view>
          <view wx:if="{{item.desc}}" class="feed-desc-text">{{item.desc}}</view>
          <view class="feed-card-foot">
            <view class="feed-avatars">
              <image
                wx:for="{{item.avatars}}"
                wx:for-item="av"
                wx:for-index="avIndex"
                wx:key="avIndex"
                class="feed-avatar"
                src="{{av}}"
                mode="aspectFill"
              />
            </view>
            <text class="feed-tag feed-tag--{{item.tone}}">{{item.tagText}}</text>
          </view>
        </view>
      </view>

      <view class="feed-more">
        {{feedLoading ? '加载中...' : (feedHasMore ? '上拉加载更多' : '没有更多了')}}
      </view>
    </view>
  </view>

  <view wx:if="{{isShareMode}}" class="page-footer">
    <button
      class="footer-btn footer-btn-primary footer-share-btn"
      bindtap="onJoinClub"
      hover-class="footer-btn-hover-primary"
      disabled="{{hasJoined || joining}}"
    >
      {{hasJoined ? '已加入俱乐部' : (joining ? '加入中...' : '加入俱乐部')}}
    </button>
  </view>
  <view wx:elif="{{canInvite}}" class="page-footer">
    <button class="footer-btn footer-btn-primary footer-share-btn" open-type="share" hover-class="footer-btn-hover-primary">邀请好友加入俱乐部</button>
  </view>
</view>
