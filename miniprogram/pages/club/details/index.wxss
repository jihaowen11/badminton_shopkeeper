/* pages/club/details/index.wxss */
page {
  --green: #0a8f3e;
  --text: #12161a;
  height: 100%;
  background: #fff;
}

.page {
  min-height: 100%;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  position: relative;
}

.hero-bg {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 360rpx;
  background-image:
    radial-gradient(700rpx 420rpx at 78% 18%, rgba(60, 231, 165, 0.34), rgba(60, 231, 165, 0) 65%),
    radial-gradient(520rpx 360rpx at 18% 26%, rgba(60, 231, 165, 0.20), rgba(60, 231, 165, 0) 60%),
    linear-gradient(180deg, #d4efe4 0%, #e2f4ec 55%, #f7fbf9 100%);
  z-index: -1;
  overflow: hidden;
}

.hero-ring {
  position: absolute;
  right: -40rpx;
  top: 40rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 999rpx;
  border: 10rpx solid rgba(255, 255, 255, 0.18);
}

.hero-ring-2 {
  right: 80rpx;
  top: 120rpx;
  width: 120rpx;
  height: 120rpx;
  opacity: 0.5;
}

.nav-bar {
  position: relative;
  z-index: 2;
  padding: 12rpx 24rpx 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.nav-right {
  display: flex;
  align-items: center;
  gap: 16rpx;
}

.nav-icon-btn {
  width: 72rpx;
  height: 72rpx;
  border-radius: 999rpx;
  background: rgba(255, 255, 255, 0.22);
  border: 1px solid rgba(255, 255, 255, 0.35);
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-icon-hover {
  background: rgba(255, 255, 255, 0.32);
}

.main-card {
  position: relative;
  z-index: 1;
  margin: 20rpx 28rpx 0;
  padding: 20rpx 28rpx 28rpx;
  background: #ffffff;
  border-radius: 28rpx;
  box-shadow: 0 9rpx 22rpx rgba(0, 0, 0, 0.1);
  border: 1px solid rgba(18, 22, 26, 0.05);
  margin-top: 190rpx;
}

.club-head-row {
  display: flex;
  gap: 24rpx;
  align-items: flex-start;
}

.club-avatar-wrap {
  position: relative;
  flex-shrink: 0;
}

.club-avatar {
  width: 120rpx;
  height: 120rpx;
  border-radius: 999rpx;
  background: rgba(10, 143, 62, 0.18);
  color: var(--green);
  font-size: 48rpx;
  font-weight: 900;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.club-avatar-img {
  width: 100%;
  height: 100%;
  display: block;
  border-radius: 999rpx;
}

.club-crown {
  position: absolute;
  right: -4rpx;
  bottom: -2rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 999rpx;
  background: linear-gradient(145deg, #ffb300, #ff9800);
  border: 4rpx solid #ffffff;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 6rpx 14rpx rgba(255, 152, 0, 0.4);
}

.club-head-text {
  flex: 1;
  min-width: 0;
  padding-top: 4rpx;
}

.club-title {
  font-size: 36rpx;
  font-weight: 900;
  color: var(--text);
  line-height: 1.25;
  margin-bottom: 14rpx;
}

.club-line {
  display: flex;
  align-items: flex-start;
  gap: 8rpx;
  margin-top: 8rpx;
}

.club-line-text {
  font-size: 24rpx;
  font-weight: 600;
  color: rgba(18, 22, 26, 0.55);
  line-height: 1.45;
  flex: 1;
}

.club-desc {
  margin-top: 22rpx;
  font-size: 26rpx;
  line-height: 1.55;
  font-weight: 600;
  color: rgba(18, 22, 26, 0.62);
}

.stat-mini-row {
  margin-top: 28rpx;
  display: flex;
  gap: 16rpx;
}

.stat-mini {
  flex: 1;
  border-radius: 18rpx;
  padding: 18rpx 12rpx;
  text-align: center;
}

.stat-mini-neutral {
  background: rgba(18, 22, 26, 0.06);
}

.stat-mini-male {
  background: rgba(47, 115, 255, 0.12);
}

.stat-mini-female {
  background: rgba(255, 107, 157, 0.12);
}

.stat-mini-num {
  font-size: 34rpx;
  font-weight: 900;
  color: var(--text);
}

.stat-mini-male .stat-mini-num {
  color: #2f73ff;
}

.stat-mini-female .stat-mini-num {
  color: #e91e8c;
}

.stat-mini-label {
  margin-top: 6rpx;
  font-size: 22rpx;
  font-weight: 700;
  color: rgba(18, 22, 26, 0.45);
}

.stat-mini-male .stat-mini-label,
.stat-mini-female .stat-mini-label {
  color: rgba(18, 22, 26, 0.5);
}

.tabs-wrap {
  flex-shrink: 0;
  padding: 24rpx 28rpx;
}

.tabs-bar {
  display: flex;
  padding: 8rpx;
  border-radius: 999rpx;
  background: rgba(18, 22, 26, 0.08);
  gap: 8rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 18rpx 12rpx;
  font-size: 28rpx;
  font-weight: 800;
  color: rgba(18, 22, 26, 0.45);
  border-radius: 999rpx;
  transition: background 0.2s, color 0.2s;
}

.tab-item.is-active {
  background: #ffffff;
  color: var(--text);
  box-shadow: 0 6rpx 16rpx rgba(0, 0, 0, 0.08);
}

.list-scroll {
  padding: 0 28rpx calc(32rpx + 140rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.member-card {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx 22rpx;
  margin-bottom: 18rpx;
  background: #ffffff;
  border-radius: 22rpx;
  box-shadow: 0 8rpx 22rpx rgba(0, 0, 0, 0.06);
  border: 1px solid rgba(18, 22, 26, 0.06);
}

.member-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 999rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 900;
  color: #ffffff;
  overflow: hidden;
}

.member-avatar-img {
  width: 100%;
  height: 100%;
  display: block;
  border-radius: 999rpx;
}

.member-avatar.avatar-green {
  background: linear-gradient(145deg, #0fb35b, #0a8f3e);
}

.member-avatar.avatar-blue {
  background: linear-gradient(145deg, #4d8dff, #2f73ff);
}

.member-avatar.avatar-pink {
  background: linear-gradient(145deg, #ff8ab0, #ff6b9d);
}

.member-main {
  flex: 1;
  min-width: 0;
}

.member-name-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  gap: 10rpx;
}

.member-name {
  font-size: 30rpx;
  font-weight: 900;
  color: rgba(18, 22, 26, 0.9);
}

.role-pill {
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  font-size: 22rpx;
  font-weight: 800;
}

.role-president {
  background: rgba(255, 152, 0, 0.18);
  color: #e65100;
}

.role-admin {
  background: rgba(10, 143, 62, 0.12);
  color: var(--green);
}

.role-member {
  background: rgba(18, 22, 26, 0.08);
  color: rgba(18, 22, 26, 0.5);
}

.member-sub {
  margin-top: 10rpx;
  display: flex;
  align-items: center;
  font-size: 24rpx;
  font-weight: 600;
  color: rgba(18, 22, 26, 0.48);
}

.member-dot {
  margin: 0 8rpx;
}

.member-more {
  width: 56rpx;
  height: 56rpx;
  border-radius: 999rpx;
  background: rgba(18, 22, 26, 0.06);
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.member-more-hover {
  background: rgba(18, 22, 26, 0.1);
}

/* ===== 动态（自动流）===== */
.feed-wrap {
  flex: 1;
  padding: 0 28rpx calc(32rpx + 140rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
}

.feed-placeholder {
  margin-top: 8rpx;
  padding: 56rpx 32rpx;
  box-sizing: border-box;
  background: #ffffff;
  border-radius: 24rpx;
  border: 1px dashed rgba(10, 143, 62, 0.2);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
}

.feed-title {
  font-size: 32rpx;
  font-weight: 900;
  color: rgba(18, 22, 26, 0.75);
}

.feed-desc {
  font-size: 26rpx;
  font-weight: 600;
  color: rgba(18, 22, 26, 0.45);
  text-align: center;
  line-height: 1.5;
}

.feed-empty-btn {
  margin-top: 12rpx;
  padding: 18rpx 44rpx;
  border-radius: 999rpx;
  font-size: 26rpx;
  font-weight: 800;
  color: #ffffff;
  background: #0a8f3e;
}

.feed-list {
  padding-top: 8rpx;
}

.feed-item {
  display: flex;
  align-items: stretch;
}

.feed-item-hover .feed-card {
  background: #f4f8f6;
}

.feed-rail {
  width: 56rpx;
  flex-shrink: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-top: 26rpx;
}

.feed-dot {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  box-shadow: 0 4rpx 12rpx rgba(18, 22, 26, 0.08);
}

.feed-dot--green {
  background: #0a8f3e;
}

.feed-dot--blue {
  background: #1677ff;
}

.feed-dot--orange {
  background: #d9860a;
}

.feed-line {
  flex: 1;
  width: 2rpx;
  margin: 8rpx 0 0;
  background: rgba(18, 22, 26, 0.08);
}

.feed-card {
  flex: 1;
  min-width: 0;
  margin-left: 16rpx;
  margin-bottom: 20rpx;
  padding: 24rpx 26rpx;
  box-sizing: border-box;
  background: #ffffff;
  border-radius: 22rpx;
  border: 1px solid rgba(18, 22, 26, 0.05);
}

.feed-card-head {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.feed-title-text {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  line-height: 40rpx;
  font-weight: 800;
  color: rgba(18, 22, 26, 0.88);
}

.feed-time {
  flex-shrink: 0;
  font-size: 22rpx;
  line-height: 40rpx;
  font-weight: 600;
  color: rgba(18, 22, 26, 0.38);
}

.feed-desc-text {
  margin-top: 8rpx;
  font-size: 25rpx;
  line-height: 36rpx;
  font-weight: 600;
  color: rgba(18, 22, 26, 0.55);
}

.feed-card-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16rpx;
  margin-top: 16rpx;
  min-height: 40rpx;
}

.feed-avatars {
  display: flex;
  align-items: center;
  gap: 8rpx;
  flex: 1;
  min-width: 0;
}

.feed-avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  flex-shrink: 0;
  background: #eef2f0;
  border: 2rpx solid #ffffff;
}

.feed-tag {
  flex-shrink: 0;
  padding: 4rpx 16rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 800;
}

.feed-tag--green {
  color: #0a8f3e;
  background: rgba(10, 143, 62, 0.1);
}

.feed-tag--blue {
  color: #1677ff;
  background: rgba(22, 119, 255, 0.1);
}

.feed-tag--orange {
  color: #d9860a;
  background: rgba(217, 134, 10, 0.12);
}

.feed-more {
  padding: 16rpx 0 8rpx;
  text-align: center;
  font-size: 23rpx;
  font-weight: 600;
  color: rgba(18, 22, 26, 0.32);
}

.sex{
  width: 28rpx;
  position: relative;
  top: 4rpx;
  left: 0;
}

.page-footer {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 100;
  display: flex;
  align-items: stretch;
  gap: 20rpx;
  padding: 16rpx 28rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  box-sizing: border-box;
  background: rgba(255, 255, 255, 0.96);
  border-top: 1px solid rgba(18, 22, 26, 0.08);
  box-shadow: 0 -10rpx 28rpx rgba(0, 0, 0, 0.06);
}

.footer-btn {
  flex: 1;
  height: 88rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  font-weight: 900;
  box-sizing: border-box;
}

.footer-btn-outline {
  border: 2rpx solid var(--green);
  color: var(--green);
  background: #ffffff;
}

.footer-btn-hover {
  opacity: 0.88;
}

.footer-btn-primary {
  color: #ffffff;
  background: linear-gradient(90deg, #0a8f3e 0%, #0fb35b 100%);
  box-shadow: 0 10rpx 22rpx rgba(10, 143, 62, 0.22);
}

.footer-btn-hover-primary {
  opacity: 0.92;
}

.footer-share-btn {
  margin: 0;
  padding: 0;
  line-height: 88rpx;
  border: none;
}

.footer-share-btn::after {
  border: none;
}

/* 详情加载失败：分享卡片失效（俱乐部已解散）时的兜底空态 */
.load-failed {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 1200;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 64rpx;
  box-sizing: border-box;
  background: #ffffff;
}

.load-failed-title {
  margin-top: 28rpx;
  font-size: 32rpx;
  font-weight: 600;
  color: #12161a;
}

.load-failed-desc {
  margin-top: 12rpx;
  font-size: 26rpx;
  line-height: 38rpx;
  color: rgba(18, 22, 26, 0.5);
  text-align: center;
}

.load-failed-btn {
  margin-top: 48rpx;
  min-width: 280rpx;
  padding: 22rpx 48rpx;
  box-sizing: border-box;
  font-size: 28rpx;
  font-weight: 600;
  text-align: center;
  color: #ffffff;
  background: linear-gradient(180deg, #34c46b 0%, #0a8f3e 100%);
  border-radius: 999rpx;
  box-shadow: 0 10rpx 28rpx rgba(10, 143, 62, 0.24);
}

.load-failed-btn-hover {
  opacity: 0.86;
}
