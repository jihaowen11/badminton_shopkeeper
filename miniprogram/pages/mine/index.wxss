  box-shadow: 0 10rpx 22rpx rgba(0,0,0,0.10);
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}

.avatar-img {
  width: 100%;
  height: 100%;
  display: block;
}

.avatar-text{
  font-size: 64rpx;
  font-weight: 900;
  color: var(--green);
}

.sex{
  width: 40rpx;
  position: relative;
  top: 4rpx;
  left: 0;
}

.edit{
  position: relative;
  top: 4rpx;
  left: 0;
}

.stat-icon{
  position: relative;
  top: 4rpx;
  left: 0;
}

.avatar-camera{
  position: absolute;
  left: 72rpx;
  bottom: -10rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 999rpx;
  background: var(--green);
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 18rpx rgba(10,143,62,0.35);
}

.profile-main{
  flex: 1;
  padding-top: 8rpx;
}

.name-row{
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.name{
  font-size: 40rpx;
  font-weight: 900;
  color: var(--text);
}

.meta-row{
  margin-top: 12rpx;
  display: flex;
  align-items: center;
  gap: 14rpx;
}

.pill{
