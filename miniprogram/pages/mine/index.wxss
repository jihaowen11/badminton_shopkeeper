}

.bio{
  margin-top: 16rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: rgba(18,22,26,0.60);
}

.divider{
  margin: 26rpx 0 22rpx;
  height: 1px;
  background: rgba(18,22,26,0.10);
  transform: scaleY(0.5);
}

.stats-row{
  display: flex;
  justify-content: space-between;
}

.stat2{
