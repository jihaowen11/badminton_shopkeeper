page{
  --green: #0a8f3e;
  --text: #12161a;
}

.mine{
  padding: 0 32rpx 220rpx;
  box-sizing: border-box;
  padding-top: 100rpx;
}

/* 入场动画（错峰，缓动不线性） */
.enter-item{
  opacity: 0;
  transform: translate3d(0, 26rpx, 0);
}

.mine.is-enter .enter-item{
  animation: mineEnter 720ms cubic-bezier(0.16, 1, 0.3, 1) both;
}

.mine.is-enter .delay-0{ animation-delay: 0ms; }
.mine.is-enter .delay-1{ animation-delay: 80ms; }
.mine.is-enter .delay-2{ animation-delay: 160ms; }
.mine.is-enter .delay-3{ animation-delay: 240ms; }

@keyframes mineEnter{
  0%{
    opacity: 0;
    transform: translate3d(0, 26rpx, 0) scale(0.985);
    filter: saturate(0.98);
  }
  70%{
    opacity: 1;
    transform: translate3d(0, -5rpx, 0) scale(1.008);
    filter: saturate(1.05);
  }
  100%{
    opacity: 1;
    transform: translate3d(0, 0, 0) scale(1);
    filter: saturate(1);
  }
}

.mine-hero{
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 420rpx;
  background-color: #e9f6f1;
  background-image:
    radial-gradient(700rpx 420rpx at 78% 18%, rgba(60, 231, 165, 0.34), rgba(60, 231, 165, 0) 65%),
    radial-gradient(520rpx 360rpx at 18% 26%, rgba(60, 231, 165, 0.20), rgba(60, 231, 165, 0) 60%),
    linear-gradient(180deg, #d4efe4 0%, #e2f4ec 55%, #f7fbf9 100%);
  z-index: -1;
  overflow: hidden;
}

.mine-hero-ring{
  position: absolute;
  right: -60rpx;
  top: 60rpx;
  width: 260rpx;
  height: 260rpx;
  border-radius: 999rpx;
  border: 10rpx solid rgba(255,255,255,0.20);
}


.profile-card{
  margin-top: 80rpx;
  background: rgba(255,255,255,1);
  border-radius: 28rpx;
  box-shadow: 0 22rpx 52rpx rgba(0,0,0,0.14);
  padding: 30rpx 28rpx 24rpx;
}

.profile-head{
  display: flex;
  gap: 22rpx;
}

.avatar-wrap{
