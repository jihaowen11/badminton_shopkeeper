  color: #fff;
}

.player-avatar.is-gray{
  background: #C0B1EB;
  color: #fff;
}

.player-name{
  font-size: 34rpx;
  color: rgba(18,22,26,0.88);
}

.vs{
  flex: 1;
  text-align: center;
}

.vs-text{
  font-size: 36rpx;
  font-weight: 900;
  letter-spacing: 4rpx;
  color: rgba(18,22,26,0.92);
}

.score{
  margin-top: 10rpx;
  font-size: 26rpx;
  font-weight: 800;
  color: rgba(18,22,26,0.55);
}

.icon{
  position: relative;
  top: 4rpx;
  left: 0;
}
/* ===== 最近比赛空态 ===== */
.match-empty {
  padding: 56rpx 32rpx;
  border-radius: 24rpx;
  background: #ffffff;
  text-align: center;
  box-shadow: 0 8rpx 22rpx rgba(0, 0, 0, 0.06);
}

.match-empty-title {
  font-size: 30rpx;
  font-weight: 900;
  color: rgba(18, 22, 26, 0.82);
