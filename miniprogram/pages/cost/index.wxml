<loading-bar />
<!--pages/cost/index.wxml-->
<view class="page">
  <back scrollTop="{{pageScrollTop}}" />

  <view class="hero">
    <canvas type="2d" id="costBallCanvas" class="hero-canvas"></canvas>
    <view class="hero-page-title">{{shared ? '好友分享的账单' : '费用计算'}}</view>
    <view class="hero-inner">
      <view class="hero-main">
        <view class="hero-wallet">
          <van-icon name="balance-o" size="44rpx" color="#ffffff" />
        </view>
        <view class="hero-cost-block">
          <view class="hero-label">总费用</view>
          <view class="hero-total"><text class="hero-currency">¥</text> {{totalText}}</view>
        </view>
      </view>
      <view class="hero-avg">
        <text class="hero-avg-label">人均约</text>
        <text class="hero-avg-value">¥ {{avgText}}</text>
      </view>
    </view>
  </view>

  <view class="sheet">
    <view class="sheet-inner">
    <view class="card">
      <view class="card-head">
        <view class="card-title">
          <van-icon class="icon" name="friends-o" size="32rpx" color="#ff9800" />
          <text>参与人员</text>
        </view>
        <text class="people-count">共 {{participants.length}} 人</text>
      </view>
      <view class="people-row">
        <view class="people-avatars">
          <view
            wx:for="{{participants}}"
            wx:key="id"
            class="people-avatar"
            data-id="{{item.id}}"
            bindtap="onTapParticipant"
            hover-class="people-avatar-hover"
          >
            <image class="people-avatar-img" src="{{item.avatar}}" mode="aspectFill" />
          </view>
        </view>
        <view class="people-add" wx:if="{{!shared}}" bindtap="onAddParticipant" hover-class="people-add-hover">+ 人员</view>
      </view>
      <view class="people-hint" wx:if="{{!shared}}">点头像可改名或删除</view>
      <view class="people-hint" wx:else>名单来自分享者，点下方按钮可改用你自己的账单</view>
    </view>

    <view class="card">
      <view class="card-head">
        <view class="card-title">
          <van-icon class="icon" name="balance-o" size="32rpx" color="#ff9800" />
          <text>费用明细</text>
        </view>
        <view class="card-add" wx:if="{{!shared}}" bindtap="onAddLine" hover-class="card-add-hover">+ 添加</view>
      </view>

      <!-- 别人的账单：只读展示，不渲染任何输入框和删除按钮 -->
      <block wx:if="{{shared}}">
        <view wx:for="{{lineItems}}" wx:key="id" class="line line-static">
          <view class="line-top">
            <view class="line-name-row">
              <image
                wx:if="{{item.type === 'court'}}"
                class="line-type-icon"
                src="/images/icon/net.png"
                mode="aspectFit"
              />
              <image wx:else class="line-type-icon" src="/images/icon/badminton.png" mode="aspectFit" />
              <text class="line-static-label">{{item.label}}</text>
            </view>
            <text wx:if="{{item.type === 'shuttle'}}" class="line-static-sub">¥{{item.unitPrice}} × {{item.qty}} 球</text>
            <view class="line-static-amount">¥{{item.lineTotal}}</view>
          </view>
          <view class="line-static-payer">
            <image class="line-static-avatar" src="{{item.payerAvatar}}" mode="aspectFill" />
            <text>{{item.payerName}} 垫付</text>
          </view>
        </view>
      </block>

      <block wx:else>
      <view wx:for="{{lineItems}}" wx:key="id" class="line">
        <view class="line-top">
          <view class="line-name-row">
            <image
              wx:if="{{item.type === 'court'}}"
              class="line-type-icon"
              src="/images/icon/net.png"
              mode="aspectFit"
            />
            <image
              wx:else
              class="line-type-icon"
              src="/images/icon/badminton.png"
              mode="aspectFit"
            />
            <!-- <input
              class="line-input line-input-name"
              value="{{item.label}}"
              placeholder="名称"
              data-id="{{item.id}}"
              bindinput="onInputLineLabel"
            /> -->
          </view>

          <block wx:if="{{item.type === 'court'}}">
            <view class="line-money">
              <text class="line-yen">¥</text>
              <input
                class="line-input line-input-amount"
                type="digit"
                value="{{item.courtAmount}}"
                placeholder="0"
                data-id="{{item.id}}"
                bindinput="onInputCourtAmount"
              />
            </view>
          </block>

          <block wx:else>
            <view class="line-shuttle">
              <view class="line-unit">
                <text class="line-yen">¥</text>
                <input
                  class="line-input line-input-unit"
                  type="digit"
                  value="{{item.unitPrice}}"
                  placeholder="单价"
                  data-id="{{item.id}}"
                  bindinput="onInputShuttleUnit"
                />
              </view>
              <view class="line-stepper">
                <view
                  class="step-btn"
                  data-id="{{item.id}}"
                  catchtap="onShuttleQtyMinus"
                  hover-class="step-btn-hover"
                >−</view>
                <view class="step-val">{{item.qty}}</view>
                <view
                  class="step-btn"
                  data-id="{{item.id}}"
                  catchtap="onShuttleQtyPlus"
                  hover-class="step-btn-hover"
                >+</view>
              </view>
              <view class="line-subtotal">¥{{item.lineTotal}}</view>
            </view>
          </block>

          <view class="line-del" data-id="{{item.id}}" catchtap="onDeleteLine" hover-class="line-del-hover">×</view>

          <view
            class="line-one-avatar"
            data-id="{{item.id}}"
            catchtap="onTapLinePayer"
            hover-class="line-one-avatar-hover"
          >
            <image class="line-avatar-img" src="{{item.payerAvatar}}" mode="aspectFill" />
          </view>
        </view>
      </view>
      </block>
    </view>

    <view class="card">
      <view class="card-head">
        <view class="card-title">
          <van-icon class="icon" name="gold-coin-o" size="32rpx" color="#ff9800" />
          <text>结算建议</text>
        </view>
        <text class="people-count">{{settlements.length ? settlements.length + ' 笔转账' : '无需转账'}}</text>
      </view>

      <view wx:if="{{settlements.length === 0}}" class="settle-empty">
        {{totalText === '0' ? '填好费用后，按「谁垫付、谁该还」自动算出转账方案' : '当前费用已结清，无需转账'}}
      </view>

      <view wx:for="{{settlements}}" wx:key="key" class="settle-row">
        <view class="settle-name settle-name--from">{{item.from}}</view>
        <view class="settle-arrow">
          <van-icon name="arrow" size="24rpx" color="rgba(18,22,26,0.35)" />
        </view>
        <view class="settle-name settle-name--to">{{item.to}}</view>
        <view class="settle-amount">¥{{item.amountText}}</view>
      </view>
    </view>
    </view>
  </view>

  <view class="footer-bar" wx:if="{{shared}}">
    <button class="footer-btn footer-btn-share" open-type="share">转发</button>
    <button class="footer-btn footer-btn-save footer-btn-wide" bindtap="onExitShared">我也要算一份</button>
  </view>

  <view class="footer-bar" wx:else>
    <button class="footer-btn footer-btn-reset" bindtap="onReset">清空</button>
    <button class="footer-btn footer-btn-save" bindtap="onSave">保存</button>
    <button class="footer-btn footer-btn-share" open-type="share">分享</button>
  </view>
</view>
