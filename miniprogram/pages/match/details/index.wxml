<loading-bar />
<!--pages/match/details/index.wxml-->
<!-- 分享卡片指向的比赛被删除/取消时，给出明确空态，别让用户对着空白页等 -->
<view wx:if="{{loadFailed}}" class="load-failed">
  <van-icon name="warning-o" size="64rpx" color="rgba(217,134,10,0.6)" />
  <view class="load-failed-title">比赛不存在或已取消</view>
  <view class="load-failed-desc">这个分享可能已经过期，去看看别的球局吧</view>
  <view class="load-failed-btn" bindtap="onBackHome" hover-class="load-failed-btn-hover">回到首页</view>
</view>
<view class="page">
  <!-- 分享海报：由 JS 按比赛信息绘制 5:4，导出为临时路径供 onShareAppMessage 使用（不可直接用 WXML 转图） -->
  <canvas type="2d" id="sharePosterCanvas" class="share-poster-canvas"></canvas>

  <back  scrollTop="{{pageScrollTop}}"/>

  <view class="hero-bg" aria-hidden="true">
    <view class="hero-ring"></view>
    <view class="hero-ring hero-ring-2"></view>
  </view>

  <view class="tabs-wrap tabs-wrap--top">
    <view class="tabs-bar">
      <view
        class="tab-item {{activeTab === 'match' ? 'is-active' : ''}}"
        data-tab="match"
        bindtap="onTab"
      >比赛</view>
      <view
        class="tab-item {{activeTab === 'pair' ? 'is-active' : ''}}"
        data-tab="pair"
        bindtap="onTab"
      >对阵</view>
      <view
        class="tab-item {{activeTab === 'rank' ? 'is-active' : ''}}"
        data-tab="rank"
        bindtap="onTab"
      >排名</view>
    </view>
  </view>

  <view wx:if="{{activeTab === 'match'}}" class="tab-panel tab-panel--match">
    <view class="main-card match-card">
      <view class="ribbon ribbon--{{match.statusKey}}">{{match.statusText}}</view>
      <view class="match-title">{{match.title}}</view>

      <view class="info-row">
        <van-icon class="icon" name="clock-o" size="14" color="rgba(18,22,26,0.45)" />
        <text class="info-text"><text class="info-k">日期：</text>{{match.dateLine}}</text>
      </view>

      <view class="info-row info-row--tap" hover-class="info-row-hover">
        <van-icon class="icon" name="description" size="14" color="rgba(18,22,26,0.45)" />
        <text class="info-text"><text class="info-k">类型：</text>{{match.typeLine}}</text>
      </view>

      <view class="info-row">
        <van-icon class="icon" name="award-o" size="14" color="rgba(18,22,26,0.45)" />
        <text class="info-text"><text class="info-k">赛制：</text>{{match.formatLine}}</text>
      </view>

      <view class="info-row">
        <van-icon class="icon" name="friends-o" size="14" color="rgba(18,22,26,0.45)" />
        <text class="info-text"><text class="info-k">人数：</text>{{match.peopleLine}}</text>
      </view>

      <view wx:if="{{match.clubLine}}" class="info-row">
        <van-icon class="icon" name="location-o" size="14" color="rgba(18,22,26,0.45)" />
        <text class="info-text"><text class="info-k">俱乐部：</text>{{match.clubLine}}</text>
      </view>


      <view class="match-divider"></view>

      <view class="info-row">
        <text class="info-text info-text--full">浏览量：{{match.views}}</text>
        <view class="row-end row-end--gap">
          <view class="new-pill">hot</view>
        </view>
      </view>
    </view>

    <view class="sub-card" bindtap="onTapRegList" hover-class="sub-card-hover">
      <view class="sub-card-title">已报名：{{match.joined}}/{{match.capacity}}</view>
      <view class="sub-card-row">
        <view class="avatar-row">
          <view
            wx:for="{{regPreview}}"
            wx:for-item="reg"
            wx:key="id"
            class="mini-avatar mini-avatar--{{reg.tone}}"
          >
            <image wx:if="{{reg.avatarUrl}}" class="mini-avatar-img" mode="aspectFill" src="{{reg.avatarUrl}}" />
            <text wx:else>{{reg.abbr}}</text>
          </view>
        </view>
        <van-icon class="icon" name="arrow" size="14" color="rgba(18,22,26,0.35)" />
      </view>
    </view>

    <view class="sub-card" bindtap="onTapOrganizer" hover-class="sub-card-hover">
      <view class="org-row">
        <view class="org-avatar org-avatar--{{organizer.tone}}">
          <image wx:if="{{organizer.avatarUrl}}" class="org-avatar-img" mode="aspectFill" src="{{organizer.avatarUrl}}" />
          <text wx:else>{{organizer.abbr}}</text>
        </view>
        <text class="org-name">{{organizer.name}}(组织者)</text>
        <van-icon class="icon org-arrow" name="arrow" size="14" color="rgba(18,22,26,0.35)" />
      </view>
    </view>

    <view wx:if="{{match.joined > 1}}" class="sub-card" bindtap="onGoCost" hover-class="sub-card-hover">
      <view class="sub-card-title">球费结算</view>
      <view class="sub-card-row">
        <text class="cost-hint">人员取自本场报名名单，自动算谁该给谁多少钱</text>
        <van-icon class="icon" name="arrow" size="14" color="rgba(18,22,26,0.35)" />
      </view>
    </view>
  </view>

  <view wx:if="{{activeTab === 'pair'}}" class="tab-panel tab-panel--list">
    <view wx:if="{{scheduleLoading}}" class="schedule-empty">排期加载中...</view>

    <block wx:elif="{{scheduleRounds.length === 0}}">
      <view class="schedule-empty">
        <view class="schedule-empty-title">还没有排期</view>
        <view class="schedule-empty-desc">
          {{canGenerate ? '当前已报名 ' + match.joined + ' 人，生成后按轮自动轮转搭档，每轮尽量不重复。' : '等组织者生成排期后，这里会显示每轮的对阵。'}}
        </view>
        <button
          wx:if="{{canGenerate}}"
          class="schedule-empty-btn"
          bindtap="onGenerateSchedule"
          loading="{{generating}}"
          disabled="{{generating}}"
        >{{generating ? '生成中...' : '生成排期'}}</button>
      </view>
    </block>

    <block wx:else>
      <view class="schedule-summary-row">
        <view class="schedule-summary">
          共 {{scheduleMeta.totalRounds}} 轮 · {{scheduleMeta.totalMatches}} 场{{scheduleMeta.courts > 0 ? ' · ' + scheduleMeta.courts + ' 片场地' : ''}} · 已完成 {{scheduleMeta.finishedMatches}} 场
        </view>
        <view
          wx:if="{{scheduleMeta.currentRound > 0 && scheduleMeta.totalRounds > 1}}"
          class="schedule-locate"
          bindtap="onLocateCurrentRound"
          hover-class="schedule-locate-hover"
        >定位第 {{scheduleMeta.currentRound}} 轮</view>
      </view>

      <view
        wx:for="{{scheduleRounds}}"
        wx:for-item="rd"
        wx:for-index="rdIdx"
        wx:key="no"
        id="round-no-{{rd.no}}"
        class="round-group {{rd.isCurrent ? 'round-group--current' : ''}}"
      >
        <view class="round-head">
          <view class="round-title-wrap">
            <text class="round-title">{{rd.label}}</text>
            <text wx:if="{{rd.isCurrent}}" class="round-current-tag">当前</text>
          </view>
          <text class="round-meta">{{rd.courts.length}} 场</text>
        </view>

        <view
          wx:for="{{rd.courts}}"
          wx:for-item="item"
          wx:for-index="cIdx"
          wx:key="id"
          class="pair-card pair-card--tap"
          data-round-id="{{item.roundId}}"
          data-index="{{cIdx}}"
          data-round-index="{{rdIdx}}"
          bindtap="onTapRound"
          hover-class="pair-card-hover"
        >
          <view class="pair-main">
            <view class="pair-team">
              <view class="pair-avatars">
                <view
                  wx:for="{{item.team1Players}}"
                  wx:for-item="p"
                  wx:key="id"
                  class="pair-avatar-img"
                >
                  <image class="pair-avatar-img-inner" mode="aspectFill" src="{{p.avatar}}" />
                  <view wx:if="{{p.isMe}}" class="me-pill">我</view>
                </view>
              </view>
              <view class="pair-names">
                <view class="pair-name-line">{{item.leftNameLine1}}</view>
                <view class="pair-name-line pair-name-line-sub">{{item.leftNameLine2}}</view>
              </view>
            </view>

            <view class="pair-vs">VS</view>

            <view class="pair-team pair-team--right">
              <view class="pair-avatars">
                <view
                  wx:for="{{item.team2Players}}"
                  wx:for-item="p"
                  wx:key="id"
                  class="pair-avatar-img"
                >
                  <image class="pair-avatar-img-inner" mode="aspectFill" src="{{p.avatar}}" />
                  <view wx:if="{{p.isMe}}" class="me-pill">我</view>
                </view>
              </view>
              <view class="pair-names pair-names--right">
                <view class="pair-name-line">{{item.rightNameLine1}}</view>
                <view class="pair-name-line pair-name-line-sub">{{item.rightNameLine2}}</view>
              </view>
            </view>
          </view>

          <view class="pair-score-panel">
            <view class="pair-score-round">{{item.courtLabel}}</view>
            <view wx:if="{{item.done}}" class="pair-score-line">
              <text class="pair-score-num {{item.winSide === 'left' ? 'is-win' : ''}}">{{item.scoreLeft}}</text>
              <text class="pair-score-sep">：</text>
              <text class="pair-score-num {{item.winSide === 'right' ? 'is-win' : ''}}">{{item.scoreRight}}</text>
            </view>
            <view wx:else class="pair-score-pending">{{item.canEdit ? '去记分' : '待开赛'}}</view>
            <view
              wx:if="{{item.done && (canGenerate || item.canEdit) && match.statusCode !== 3 && match.statusCode !== 5}}"
              class="pair-score-undo"
              data-round-id="{{item.roundId}}"
              catchtap="onClearScore"
            >撤销</view>
          </view>
        </view>
      </view>

      <view wx:if="{{canGenerate}}" class="schedule-actions">
        <view class="schedule-action-btn" bindtap="onRegenerate" hover-class="schedule-action-hover">
          <van-icon name="replay" size="14" color="rgba(18,22,26,0.6)" />
          <text>重新排期</text>
        </view>
        <view
          wx:if="{{match.statusCode === 2}}"
          class="schedule-action-btn schedule-action-btn--danger"
          bindtap="onFinishMatch"
          hover-class="schedule-action-hover"
        >
          <van-icon name="passed" size="14" color="rgba(224,32,32,0.85)" />
          <text>结束比赛</text>
        </view>
      </view>
    </block>
  </view>

  <view wx:if="{{activeTab === 'rank'}}" class="tab-panel tab-panel--list">
    <view wx:if="{{scheduleMeta.finishedMatches === 0}}" class="schedule-empty">
      <view class="schedule-empty-title">还没有比分</view>
      <view class="schedule-empty-desc">打完第一场并录入比分后，这里会实时算出胜-负与净胜分排名。</view>
    </view>

    <block wx:else>
      <view class="schedule-summary">已统计 {{scheduleMeta.finishedMatches}} 场 · 排序：胜场 → 净胜分 → 得分</view>
      <view class="rank-card">
        <view class="rank-head">
          <text class="rank-col rank-col--w">名次</text>
          <text class="rank-col rank-col--grow">选手</text>
          <text class="rank-col rank-col--wl">胜-负</text>
          <text class="rank-col rank-col--num">净胜</text>
        </view>
        <view
          wx:for="{{rankings}}"
          wx:key="id"
          class="rank-row {{item.rank <= 3 ? 'rank-row--top' : ''}}"
        >
          <view class="rank-col rank-col--w">
            <view wx:if="{{item.rank === 1}}" class="medal medal--gold">1</view>
            <view wx:elif="{{item.rank === 2}}" class="medal medal--silver">2</view>
            <view wx:elif="{{item.rank === 3}}" class="medal medal--bronze">3</view>
            <text wx:else class="rank-num">{{item.rank}}</text>
          </view>
          <view class="rank-col rank-col--grow rank-name-wrap">
            <view class="rank-avatar-wrap">
              <image class="rank-avatar-img" mode="aspectFill" src="{{item.avatar}}" />
              <view wx:if="{{item.isMe}}" class="me-pill me-pill--small">我</view>
            </view>
            <text class="rank-name">{{item.name}}</text>
          </view>
          <text class="rank-col rank-col--wl"><text class="wl-a">{{item.win}}</text><text class="wl-sep">-</text><text class="wl-b">{{item.lose}}</text></text>
          <text class="rank-col rank-col--num">{{item.diff}}</text>
        </view>
      </view>
    </block>
  </view>

  <view class="page-footer">
    <view class="footer-actions">
      <block wx:if="{{canManageFooter && showInviteClub}}">
        <button class="footer-action-btn footer-forward" open-type="share" hover-class="footer-action-btn-hover">邀请好友</button>
        <button class="footer-action-btn footer-club" bindtap="onInviteClub" hover-class="footer-action-btn-hover">邀请俱乐部</button>
        <button class="footer-action-btn footer-cancel" bindtap="onCancelMatch" hover-class="footer-action-btn-hover">取消赛事</button>
      </block>
      <block wx:elif="{{canManageFooter}}">
        <button class="footer-action-btn footer-forward" open-type="share" hover-class="footer-action-btn-hover">邀请好友</button>
        <button class="footer-action-btn footer-cancel" bindtap="onCancelMatch" hover-class="footer-action-btn-hover">取消赛事</button>
      </block>
      <block wx:elif="{{isShareMode && match.statusCode === 1}}">
        <button
          class="footer-action-btn footer-join footer-share-btn"
          bindtap="onJoinMatch"
          hover-class="footer-action-btn-hover"
          disabled="{{hasJoined || joining || (match.capacity > 0 && match.joined >= match.capacity)}}"
        >
          {{hasJoined ? '已报名' : (joining ? '报名中...' : ((match.capacity > 0 && match.joined >= match.capacity) ? '报名已满' : '我要报名'))}}
        </button>
      </block>
      <block wx:else>
        <button class="footer-action-btn footer-forward" open-type="share" hover-class="footer-action-btn-hover">转发</button>
        <button
          wx:if="{{match.statusCode === 1 && !hasJoined}}"
          class="footer-action-btn footer-status footer-status--open"
          bindtap="onJoinMatch"
          hover-class="footer-action-btn-hover"
          disabled="{{joining || (match.capacity > 0 && match.joined >= match.capacity)}}"
        >
          {{joining ? '报名中...' : ((match.capacity > 0 && match.joined >= match.capacity) ? '报名已满' : '我要报名')}}
        </button>
        <view wx:else class="footer-status footer-status--{{match.statusKey}}">
          {{hasJoined && match.statusCode === 1 ? '已报名' : match.actionText}}
        </view>
      </block>
    </view>
  </view>

  <!-- 排期设置：场地片数 + 轮数 -->
  <view wx:if="{{roundPickerVisible}}" class="round-picker-mask" bindtap="onCloseRoundPicker">
    <view class="round-picker-dialog" catchtap="stopInviteModalBubble">
      <view class="round-picker-head">
        <text class="round-picker-title">排期设置</text>
        <text class="round-picker-sub">{{roundPickHint}}</text>
      </view>

      <view class="round-picker-row">
        <text class="round-picker-row-label">场地片数</text>
        <view class="round-picker-ctrl">
          <view
            class="round-mini-btn {{roundPickCourts <= 1 ? 'round-mini-btn--off' : ''}}"
            data-dir="-1"
            bindtap="onCourtStep"
            hover-class="round-step-hover"
          >−</view>
          <view class="round-mini-value">
            <text class="round-mini-num">{{roundPickCourts}}</text>
            <text class="round-mini-unit">片</text>
          </view>
          <view
            class="round-mini-btn {{roundPickCourts >= roundPickCourtsMax ? 'round-mini-btn--off' : ''}}"
            data-dir="1"
            bindtap="onCourtStep"
            hover-class="round-step-hover"
          >＋</view>
        </view>
      </view>

      <view class="round-picker-row">
        <text class="round-picker-row-label">轮数</text>
        <view class="round-picker-ctrl">
          <view
            class="round-mini-btn {{roundPick <= 1 ? 'round-mini-btn--off' : ''}}"
            data-dir="-1"
            bindtap="onRoundStep"
            hover-class="round-step-hover"
          >−</view>
          <view class="round-mini-value">
            <text class="round-mini-num">{{roundPick}}</text>
            <text class="round-mini-unit">轮</text>
          </view>
          <view
            class="round-mini-btn {{roundPick >= roundPickMax ? 'round-mini-btn--off' : ''}}"
            data-dir="1"
            bindtap="onRoundStep"
            hover-class="round-step-hover"
          >＋</view>
        </view>
      </view>

      <view class="round-picker-total">共 {{roundPickTotal}} 场（{{roundPickCourts}} 片场地 × {{roundPick}} 轮）</view>
      <view
        wx:if="{{roundPick !== roundPickDefault}}"
        class="round-picker-reset"
        bindtap="onRoundReset"
      >恢复推荐 {{roundPickDefault}} 轮</view>

      <view class="round-picker-footer">
        <button class="round-picker-btn round-picker-btn--ghost" bindtap="onCloseRoundPicker">取消</button>
        <button
          class="round-picker-btn round-picker-btn--primary"
          bindtap="onConfirmRoundPick"
          loading="{{generating}}"
          disabled="{{generating}}"
        >{{generating ? '排期中...' : '开始排期'}}</button>
      </view>
    </view>
  </view>

  <!-- 场次计分弹层 -->
  <view wx:if="{{scoreVisible}}" class="score-mask" bindtap="onCloseScore">
    <view class="score-sheet" catchtap="stopInviteModalBubble">
      <view class="score-head">
        <text class="score-title">{{scoreTitle}}</text>
        <text class="score-sub">{{scoreSubTitle}}</text>
      </view>

      <!-- 左右对阵：两栏并排，谁领先一眼看得出 -->
      <view class="score-board">
        <view class="score-side {{scoreWinner === 'team1' ? 'is-win' : ''}}">
          <view class="score-side-head">
            <block wx:for="{{scoreTeam1Avatars}}" wx:key="index">
              <image class="score-avatar" src="{{item}}" mode="aspectFill" />
            </block>
            <text wx:if="{{scoreWinner === 'team1'}}" class="score-win-tag">胜</text>
          </view>
          <view class="score-side-num {{scoreWinner === 'team1' ? 'is-win' : ''}}">{{scoreLeft}}</view>
          <view class="score-side-ctrl">
            <view
              class="score-btn"
              data-side="team1"
              data-dir="-1"
              bindtap="onScoreStep"
              bindtouchstart="onScorePressStart"
              bindtouchend="onScorePressEnd"
              bindtouchcancel="onScorePressEnd"
              hover-class="score-btn-hover"
              hover-stay-time="60"
            >−</view>
            <view
              class="score-btn score-btn--plus {{scorePressing === 'team1' ? 'is-pressing' : ''}}"
              data-side="team1"
              data-dir="1"
              bindtap="onScoreStep"
              bindtouchstart="onScorePressStart"
              bindtouchend="onScorePressEnd"
              bindtouchcancel="onScorePressEnd"
              hover-class="score-btn-hover"
              hover-stay-time="60"
            >＋</view>
          </view>
        </view>

        <view class="score-vs">
          <text class="score-vs-text">VS</text>
        </view>

        <view class="score-side {{scoreWinner === 'team2' ? 'is-win' : ''}}">
          <view class="score-side-head">
            <block wx:for="{{scoreTeam2Avatars}}" wx:key="index">
              <image class="score-avatar" src="{{item}}" mode="aspectFill" />
            </block>
            <text wx:if="{{scoreWinner === 'team2'}}" class="score-win-tag">胜</text>
          </view>
          <view class="score-side-num {{scoreWinner === 'team2' ? 'is-win' : ''}}">{{scoreRight}}</view>
          <view class="score-side-ctrl">
            <view
              class="score-btn"
              data-side="team2"
              data-dir="-1"
              bindtap="onScoreStep"
              bindtouchstart="onScorePressStart"
              bindtouchend="onScorePressEnd"
              bindtouchcancel="onScorePressEnd"
              hover-class="score-btn-hover"
              hover-stay-time="60"
            >−</view>
            <view
              class="score-btn score-btn--plus {{scorePressing === 'team2' ? 'is-pressing' : ''}}"
              data-side="team2"
              data-dir="1"
              bindtap="onScoreStep"
              bindtouchstart="onScorePressStart"
              bindtouchend="onScorePressEnd"
              bindtouchcancel="onScorePressEnd"
              hover-class="score-btn-hover"
              hover-stay-time="60"
            >＋</view>
          </view>
        </view>
      </view>

      <view class="score-hint {{scoreWinner ? 'score-hint--win' : ''}}">
        {{scoreWinnerText || '点 ＋ 记 1 分，长按 ＋ 可连续加分'}}
      </view>

      <view class="score-footer">
        <button class="score-btn-ghost" bindtap="onScoreReset" disabled="{{scoreSaving}}">清零</button>
        <button
          class="score-btn-primary"
          bindtap="onScoreSave"
          loading="{{scoreSaving}}"
          disabled="{{scoreSaving}}"
        >{{scoreSaved ? '更新比分' : '保存比分'}}</button>
      </view>

      <view wx:if="{{scoreCanUndo}}" class="score-undo" bindtap="onScoreUndo">撤销这场比分</view>
    </view>
  </view>

  <!-- 邀请俱乐部成员 -->
  <view wx:if="{{inviteClubVisible}}" class="invite-club-mask" bindtap="onCloseInviteClubModal">
    <view class="invite-club-dialog" catchtap="stopInviteModalBubble">
      <view class="invite-club-head">
        <text class="invite-club-title">邀请俱乐部成员</text>
        <text class="invite-club-sub">{{inviteClubName}}</text>
        <text class="invite-club-tip">{{inviteTip}}</text>
      </view>

      <view wx:if="{{inviteClubLoading}}" class="invite-club-loading">加载中...</view>

      <scroll-view wx:else scroll-y class="invite-club-scroll" show-scrollbar="{{false}}">
        <view class="invite-club-list">
          <view
            wx:for="{{inviteMemberList}}"
            wx:key="openId"
            class="invite-club-card {{item.disabled ? 'invite-club-card--disabled' : ''}}"
            data-open-id="{{item.openId}}"
            bindtap="onToggleInviteMember"
            hover-class="{{item.disabled ? '' : 'invite-club-card-hover'}}"
          >
            <view class="club-avatar-wrap">
              <view class="club-avatar">
                <image wx:if="{{item.avatarUrl}}" class="club-avatar-img" src="{{item.avatarUrl}}" mode="aspectFill" />
                <text wx:else>{{item.abbr}}</text>
              </view>
              <view wx:if="{{item.isPresident}}" class="club-crown">
                <van-icon name="gem" size="24rpx" color="#ffffff" />
              </view>
            </view>
            <view class="club-main">
              <view class="club-name">{{item.name}}</view>
              <view class="club-meta-col">
                <view class="meta-row">
                  <van-icon class="icon" name="friends-o" size="28rpx" color="rgba(18,22,26,0.38)" />
                  <text class="meta-text">{{item.metaLine1}}</text>
                </view>
                <view class="meta-row">
                  <van-icon class="icon" name="award-o" size="28rpx" color="rgba(18,22,26,0.38)" />
                  <text class="meta-text">{{item.metaLine2}}</text>
                </view>
              </view>
            </view>
            <view class="club-check" data-open-id="{{item.openId}}" catchtap="onToggleInviteMember">
              <view class="invite-check {{item.checked ? 'invite-check--on' : ''}} {{item.disabled ? 'invite-check--disabled' : ''}}">
                <van-icon wx:if="{{item.checked}}" name="success" size="28rpx" color="#ffffff" />
              </view>
            </view>
          </view>
        </view>
      </scroll-view>

      <view wx:if="{{!inviteClubLoading}}" class="invite-club-footer">
        <button class="invite-club-btn invite-club-btn--ghost" bindtap="onCloseInviteClubModal">取消</button>
        <button class="invite-club-btn invite-club-btn--primary" bindtap="onConfirmInviteClub">确定邀请<text wx:if="{{inviteSelected}}">（{{inviteSelected}} 人）</text></button>
      </view>
    </view>
  </view>
</view>
