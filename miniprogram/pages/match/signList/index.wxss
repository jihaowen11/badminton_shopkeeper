/* pages/match/signList/index.wxss */
page {
  --green: #0a8f3e;
  --text: #12161a;
  height: 100%;
  background: #fff;
}

.page {
  min-height: 100%;
  box-sizing: border-box;
  position: relative;
  padding-bottom: calc(40rpx + env(safe-area-inset-bottom));
}

.hero-bg {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  height: 360rpx;
  background-image:
    radial-gradient(700rpx 420rpx at 78% 18%, rgba(60, 231, 165, 0.34), rgba(60, 231, 165, 0) 65%),
    radial-gradient(520rpx 360rpx at 18% 26%, rgba(60, 231, 165, 0.2), rgba(60, 231, 165, 0) 60%),
    linear-gradient(180deg, #d4efe4 0%, #e2f4ec 55%, #f7fbf9 100%);
  z-index: -1;
  overflow: hidden;
}

.hero-ring {
  position: absolute;
  right: -40rpx;
  top: 40rpx;
  width: 200rpx;
  height: 200rpx;
  border-radius: 999rpx;
  border: 10rpx solid rgba(255, 255, 255, 0.18);
}

.hero-ring-2 {
  right: 80rpx;
  top: 120rpx;
  width: 120rpx;
  height: 120rpx;
  opacity: 0.5;
}

.header {
  padding: 190rpx 28rpx 24rpx;
}

.header-title {
  font-size: 44rpx;
  font-weight: 900;
  color: var(--text);
  line-height: 1.2;
}

.header-sub {
  margin-top: 12rpx;
  font-size: 28rpx;
  font-weight: 700;
  color: rgba(18, 22, 26, 0.62);
  line-height: 1.4;
}

.header-count {
  margin-top: 10rpx;
  font-size: 26rpx;
  font-weight: 700;
  color: var(--green);
}

.state-box {
  padding: 80rpx 28rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 600;
  color: rgba(18, 22, 26, 0.45);
}

.state-box--empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 20rpx;
}

.state-text {
  font-size: 28rpx;
  font-weight: 700;
  color: rgba(18, 22, 26, 0.45);
}

.list-wrap {
  padding: 0 28rpx 24rpx;
  box-sizing: border-box;
}

.member-card {
  background: #ffffff;
  border-radius: 24rpx;
  padding: 24rpx;
  margin-bottom: 18rpx;
  box-shadow: 0 5rpx 16rpx rgba(0, 0, 0, 0.06);
  border: 1px solid rgba(18, 22, 26, 0.06);
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.member-card-hover {
  opacity: 0.96;
}

.member-avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 999rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 34rpx;
  font-weight: 900;
  color: #ffffff;
  flex-shrink: 0;
  overflow: hidden;
}

.member-avatar--green {
  background: linear-gradient(145deg, #0fb35b, #0a8f3e);
}

.member-avatar--blue {
  background: linear-gradient(145deg, #4d8dff, #2f73ff);
}

.member-avatar--pink {
  background: linear-gradient(145deg, #ff8ab0, #ff6b9d);
}

.member-avatar--orange {
  background: linear-gradient(145deg, #ffb300, #ff9800);
}

.member-avatar-img {
  width: 100%;
  height: 100%;
  display: block;
  border-radius: 999rpx;
}

.member-main {
  flex: 1;
  min-width: 0;
}

.member-name-row {
  display: flex;
  align-items: center;
  gap: 12rpx;
  flex-wrap: wrap;
}

.member-name {
  font-size: 32rpx;
  font-weight: 900;
  color: rgba(18, 22, 26, 0.9);
  line-height: 1.25;
}

.role-pill {
  padding: 4rpx 12rpx;
  border-radius: 999rpx;
  font-size: 20rpx;
  font-weight: 800;
  color: #e65100;
  background: rgba(255, 152, 0, 0.16);
}

.member-action {
  flex-shrink: 0;
  padding: 12rpx 20rpx;
  border-radius: 999rpx;
  font-size: 24rpx;
  font-weight: 800;
  color: #ff4d4f;
  background: rgba(255, 77, 79, 0.08);
  border: 1px solid rgba(255, 77, 79, 0.18);
}

.member-action-hover {
  opacity: 0.88;
}
