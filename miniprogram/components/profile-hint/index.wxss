/* 资料完善轻提示：只占底部一条，不覆盖操作区 */
.phint {
  position: fixed;
  left: 24rpx;
  right: 24rpx;
  z-index: 900;
  display: flex;
  align-items: center;
  padding: 16rpx 10rpx 16rpx 18rpx;
  background: rgba(255, 255, 255, 0.98);
  border: 1rpx solid rgba(10, 143, 62, 0.14);
  border-radius: 22rpx;
  box-shadow: 0 12rpx 40rpx rgba(18, 22, 26, 0.12), 0 2rpx 8rpx rgba(18, 22, 26, 0.04);

  /* 未显示时完全让出点击：不会挡住底栏按钮 */
  opacity: 0;
  transform: translateY(28rpx) scale(0.98);
  pointer-events: none;
  transition: opacity 240ms ease, transform 280ms cubic-bezier(0.22, 0.9, 0.34, 1);
}

.phint.is-visible {
  opacity: 1;
  transform: translateY(0) scale(1);
  pointer-events: auto;
}

.phint-bar {
  width: 6rpx;
  height: 56rpx;
  margin-right: 16rpx;
  border-radius: 6rpx;
  background: linear-gradient(180deg, #34c46b 0%, #0a8f3e 100%);
  flex-shrink: 0;
}

.phint-main {
  flex: 1;
  min-width: 0;
  padding: 4rpx 0;
}

.phint-main-hover {
  opacity: 0.72;
}

.phint-title {
  font-size: 26rpx;
  font-weight: 600;
  color: #12161a;
  line-height: 34rpx;
}

.phint-desc {
  margin-top: 4rpx;
  font-size: 22rpx;
  color: rgba(18, 22, 26, 0.55);
  line-height: 30rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.phint-go {
  flex-shrink: 0;
  margin-left: 12rpx;
  padding: 8rpx 20rpx;
  font-size: 24rpx;
  font-weight: 600;
  color: #0a8f3e;
  background: rgba(10, 143, 62, 0.1);
  border-radius: 999rpx;
}

.phint-close {
  flex-shrink: 0;
  width: 48rpx;
  height: 48rpx;
  margin-left: 4rpx;
  font-size: 30rpx;
  line-height: 44rpx;
  text-align: center;
  color: rgba(18, 22, 26, 0.35);
}

.phint-close-hover {
  color: rgba(18, 22, 26, 0.65);
}
