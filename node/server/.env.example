# 复制为 .env 后填写真实值；.env 不进版本库
NODE_ENV=development
PORT=3000

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=badminton
DB_USER=root
DB_PASSWORD=
DB_TIMEZONE=+08:00

# 微信小程序
WX_APPID=
WX_APPSECRET=
# 访问微信接口的超时时间（毫秒），默认 10000
WX_API_TIMEOUT=10000
# 访问微信接口的代理。默认留空=强制直连，忽略系统 HTTP(S)_PROXY 环境变量。
# 只有服务器必须走代理才能出网时才填，例如 http://127.0.0.1:7890
WX_HTTP_PROXY=

# 登录令牌签名密钥（务必改成随机长串，泄露等于所有用户可被冒充）
JWT_SECRET=
# 令牌有效期（秒），默认 7 天
JWT_EXPIRES_IN=604800

# 小程序访问到的服务地址（用于头像等静态资源拼接）
PUBLIC_BASE_URL=http://127.0.0.1:3000
