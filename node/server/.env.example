# 复制为 .env 后填写真实值；.env 不进版本库
NODE_ENV=development
PORT=3000

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=badminton
DB_USER=root
DB_PASSWORD=
DB_TIMEZONE=+08:00

# 微信小程序
WX_APPID=
WX_APPSECRET=
# 访问微信接口的超时时间（毫秒），默认 10000
WX_API_TIMEOUT=10000
# 访问微信接口的代理。默认留空=强制直连，忽略系统 HTTP(S)_PROXY 环境变量。
# 只有服务器必须走代理才能出网时才填，例如 http://127.0.0.1:7890
WX_HTTP_PROXY=

# 登录令牌签名密钥（务必改成随机长串，泄露等于所有用户可被冒充）
JWT_SECRET=
# 令牌有效期（秒），默认 7 天
JWT_EXPIRES_IN=604800

# 小程序访问到的服务地址（用于头像等静态资源拼接）
PUBLIC_BASE_URL=http://127.0.0.1:3000

# ===== 垃圾数据回收（定时任务，服务启动后自动运行）=====
# 总开关，false = 完全不扫（排查问题时可以临时关掉）
RECYCLE_ENABLED=true
# 报名中超过多少天没开赛 → 自动取消，默认 30
RECYCLE_OPEN_DAYS=30
# 进行中超过多少天没结束 → 自动结束，默认 3
RECYCLE_PLAYING_DAYS=3
# 已取消超过多少天 → 连带报名/排期/比分一起删除，默认 3
RECYCLE_CANCELLED_DAYS=3
# 检查间隔（分钟），默认 60
RECYCLE_INTERVAL_MINUTES=60
# 单轮最多删多少场，防止逻辑写错一次清空，默认 200
RECYCLE_MAX_REMOVE=200
