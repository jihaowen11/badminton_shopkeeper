# 生产环境变量模板
#
# 复制到 C:\apps\badminton\repo\node\server\.env 后逐项填写。
# .env 已被 .gitignore 排除，不要提交到仓库。
#
# 标 [必改] 的项留空会导致启动失败或安全风险。

NODE_ENV=production
# 后端只监听本机，由 Nginx / Caddy 反代对外；不要改成 0.0.0.0
# 端口必须和反向代理的 proxy_pass 一致；本机 3000 已被其它项目占用，这里用 3001
PORT=3001
HOST=127.0.0.1

# ===== MySQL [必改] =====
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=badminton
DB_USER=badminton
DB_PASSWORD=
DB_TIMEZONE=+08:00

# ===== 微信小程序 [必改] =====
# 与微信公众平台「开发管理 - 开发设置」里的一致，错误会导致所有登录失败
WX_APPID=
WX_APPSECRET=
WX_API_TIMEOUT=10000
# 服务器能直连微信接口时留空。留空=强制直连，忽略系统代理变量
WX_HTTP_PROXY=

# ===== 登录令牌 [必改] =====
# 生成方式（PowerShell）：
# -join ((48..57)+(65..90)+(97..122) | Get-Random -Count 64 | ForEach-Object { [char]$_ })
# 留空等于任何人都能伪造任意 openId 登录
JWT_SECRET=
JWT_EXPIRES_IN=604800

# 对外访问地址，用于拼接头像等静态资源；必须 https、带路径前缀、结尾不要带斜杠
PUBLIC_BASE_URL=https://esccry.top/api/badminton

# ===== 垃圾数据回收（服务启动后自动运行）=====
# 只能单实例运行，多进程会重复执行删除逻辑
RECYCLE_ENABLED=true
RECYCLE_OPEN_DAYS=30
RECYCLE_PLAYING_DAYS=3
RECYCLE_CANCELLED_DAYS=3
RECYCLE_INTERVAL_MINUTES=60
RECYCLE_MAX_REMOVE=200
